# Turso Cloud connection settings for Jouduto.
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored;
# this example file is not.
#
# The app keeps one database per fiscal year, so there is one remote URL per
# year. `FIRST_YEAR` in appstate.py is 2023, so 2023..<current year> are the
# years the app expects.

# Token used to authenticate every request to Turso.
# Create one with:  turso db tokens create
TURSO_AUTH_TOKEN=

# Remote database URLs, as shown on the Turso dashboard.
TURSO_URL_2023=https://your-2023-database.your-org.turso.io
TURSO_URL_2024=https://your-2024-database.your-org.turso.io
TURSO_URL_2025=https://your-2025-database.your-org.turso.io
TURSO_URL_2026=https://your-2026-database.your-org.turso.io

# Optional: how long a local replica waits on a `pull()` before serving the
# data it already has. Defaults to 1000 ms.
# TURSO_PULL_TIMEOUT_MS=1000
